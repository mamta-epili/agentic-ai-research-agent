# Which LLM to use: "gemini" for real reasoning, "mock" for offline demo.
LLM_PROVIDER=gemini

# Your Gemini API key from Google AI Studio. Never commit this file.
GEMINI_API_KEY=your-key-here

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
PORT=4000
RUNS_FILE=./data/runs.json

# Image OCR for corpus uploads. Off by default (PDF + text extraction always work).
# Set to true and install tesseract.js to extract text from uploaded images.
OCR_ENABLED=false

# Shared admin password/key. The admin panel sends this as the x-admin-key header.
# If unset, admin endpoints are UNPROTECTED (dev only).
ADMIN_KEY=change-me-admin-key

# Storage backend: "supabase" (Postgres) or "json" (local file, no DB needed).
DB_DRIVER=supabase

# Supabase run store. Use the SERVICE ROLE key (server-side only, never in a frontend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Postgres connection string, used by `npm run db:push` to apply migrations.
# Supabase → Project Settings → Database → Connection string → URI.
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Where the json driver stores data (only used when DB_DRIVER=json).
DB_FILE=./data/store.json

# Editor image uploads.
# supabase mode: public Storage bucket name (created by the storage migration).
STORAGE_BUCKET=corpus-assets
# json mode: local folder for uploads + the base URL they're served from.
UPLOADS_DIR=./data/uploads
PUBLIC_URL=http://localhost:4000
